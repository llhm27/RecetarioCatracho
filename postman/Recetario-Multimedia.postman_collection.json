                  "pm.test(\"Es video/mp4\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"video/mp4\"); });",
                  "pm.test(\"Anuncia soporte de rangos\", function () { pm.expect(pm.response.headers.get(\"Accept-Ranges\")).to.eql(\"bytes\"); });"
                ]
              }
