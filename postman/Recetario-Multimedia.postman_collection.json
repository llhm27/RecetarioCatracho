{
  "info": {
    "name": "Recetario Catracho - Imagen Base64 y video",
    "description": "Pruebas de imagen (Base64) y video (multipart) de las recetas. Ajusta baseUrl y recetaId en las variables de la coleccion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Imagen (Base64)",
      "item": [
        {
          "name": "1. PUT imagen-base64 - OK (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Devuelve la ruta guardada\", function () { pm.expect(pm.response.json().ruta).to.include(\"imagenes/\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recetas/{{recetaId}}/imagen-base64",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recetas",
                "{{recetaId}}",
                "imagen-base64"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreArchivo\": \"foto.png\",\n  \"imagenBase64\": \"{{base64Png}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Imagen de prueba de 1x1 px. Para la evidencia del PDF reemplaza imagenBase64 por el Base64 de una foto real (JPG, PNG o WebP de hasta 5 MB)."
          }
        },
        {
