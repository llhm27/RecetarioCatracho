        {
          "name": "6. PUT imagen-base64 - Mas de 5 MB (413)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Base64 valido de 8 millones de caracteres (6 MB decodificados)",
                  "pm.variables.set(\"base64Grande\", \"A\".repeat(8 * 1024 * 1024));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
